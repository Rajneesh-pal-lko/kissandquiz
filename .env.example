# Copy to .env.local for local development (never commit real values).
# Without MONGODB_URI, `npm run dev` uses an in-memory store (data lost on restart).
# Get the string from MongoDB Atlas → Connect → Drivers. Put your real password in place of <password>.
MONGODB_URI=mongodb://<username>:<password>@<host1>,<host2>,<host3>/?ssl=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
# Optional, defaults to "kissandquiz"
MONGODB_DB=kissandquiz
